VITE_APP_DEFAULTAUTH=jwt

# Proxy utilizado durante desarrollo local
VITE_AUTH_URL=http://localhost:8081
VITE_CATALOGO_URL=http://localhost:8082
VITE_PEDIDOS_URL=http://localhost:8083
VITE_PAGOS_URL=http://localhost:8084

# URL utilizada por el frontend para autenticacion.
# Localmente pasa por el proxy de Vite/Nginx.
# En Azure se configurara con la URL publica del Auth Service.
VITE_AUTH_API_URL=/api/auth